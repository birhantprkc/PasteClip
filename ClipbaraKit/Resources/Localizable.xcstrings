        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本未设置 iCloud。"
          }
        }
      }
    },
    "iOS asks for permission each time unless you set Paste from Other Apps to Allow in Settings > Clipbara." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 > Clipbara에서 '다른 앱에서 붙여넣기'를 허용으로 바꾸지 않으면 iOS가 매번 허락을 묻습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在“设置”>“Clipbara”中将“从其他 App 粘贴”设为“允许”，否则 iOS 每次都会询问。"
          }
        }
      }
    },
