    "Clipbara's data in iCloud is deleted and sync turns off on every device. Clips already on each device stay there." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 있는 Clipbara 데이터가 삭제되고 모든 기기에서 동기화가 꺼집니다. 각 기기에 있던 클립은 그대로 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 中的 Clipbara 数据将被删除，所有设备上的同步都会关闭。各设备上已有的剪贴内容会保留。"
          }
        }
      }
    },
    "Clipboard" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴板"
          }
        }
      }
    },
    "Clips on a pinboard are never removed by the limit." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀보드에 있는 클립은 제한에 걸려도 지워지지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钉板中的剪贴内容不会因上限被删除。"
