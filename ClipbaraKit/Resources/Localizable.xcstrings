    },
    "%lld clips and %lld pinboards on this device will be uploaded to your iCloud account." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 클립 %1$lld개와 핀보드 %2$lld개가 iCloud 계정에 업로드됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的 %1$lld 个剪贴内容和 %2$lld 个钉板将上传到你的 iCloud 账户。"
          }
        }
      }
    },
    "%lld clips, %lld images (about %@), and %lld pinboards on this device will be uploaded to your iCloud account." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 클립 %1$lld개, 이미지 %2$lld장(약 %3$@), 핀보드 %4$lld개가 iCloud 계정에 업로드됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的 %1$lld 个剪贴内容、%2$lld 张图片（约 %3$@）和 %4$lld 个钉板将上传到你的 iCloud 账户。"
          }
        }
      }
    },
    "%lld selected" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
