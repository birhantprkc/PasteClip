        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴板"
          }
        }
      }
    },
    "Clips on a pinboard are never removed by the limit." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀보드에 있는 클립은 제한에 걸려도 지워지지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钉板中的剪贴内容不会因上限被删除。"
